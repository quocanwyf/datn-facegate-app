# Sao chép thành .env (KHÔNG commit .env). Bản demo chạy HTTP trong LAN.
DATABASE_URL=postgresql+asyncpg://facegate:<mat-khau>@localhost:5432/facegate_dev
JWT_SECRET=<sinh bằng: python -c "import secrets;print(secrets.token_urlsafe(48))">
COMPANY_TZ=Asia/Ho_Chi_Minh

# Địa chỉ Hub mà Kiosk/QR dùng (máy ảo Android trên cùng máy: http://10.0.2.2:8000 ; máy khác trong LAN: http://<IP-LAN>:8000)
HUB_PUBLIC_URL=http://10.0.2.2:8000
CORS_ORIGINS=http://localhost:5173

# Thư mục dữ liệu Hub (ảnh mẫu đã căn chỉnh, crop người lạ) — ngoài repo
HUB_DATA_DIR=C:/facegate-data

# Mô hình (checkpoint gửi riêng — kiểm bằng: python 03-app/tools/kiem-checkpoint.py)
MODEL_PATH=02-thuc-nghiem/results/V1-s3-Hy/phien-1/r18_uniface_v1_lam0.6_m0.45_s3_e28/checkpoints/best.pt
MODEL_MANIFEST_ID=r18_uniface_v1_lam0.6_m0.45_s3_e28:best
DATN_CODE_DIR=03-app/hub/vendor/code
YUNET_PATH=03-app/hub/vendor/code/fr/align/models/face_detection_yunet_2023mar.onnx
MINIFAS_DIR=03-app/hub/vendor/silentface
# auto | cuda | cpu   (máy Hy: cpu ; laptop An: cuda)
INFER_DEVICE=auto
LOG_LEVEL=INFO
