{
  "name": "facegate-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "typecheck:api": "tsc --noEmit --strict --target ES2022 --module ESNext --moduleResolution Bundler src/api/client.ts",
    "lint": "eslint .",
    "gen:api": "openapi-typescript ../openapi/openapi.yaml -o src/api/schema.d.ts",
    "test:e2e": "playwright test",
    "review:auth": "playwright test --config playwright.review.config.ts"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.2.0",
    "@fontsource/inter": "^5.2.0",
    "@gsap/react": "^2.1.2",
    "@tanstack/react-query": "^5.107.1",
    "antd": "^5.29.0",
    "dayjs": "^1.11.23",
    "gsap": "^3.15.1",
    "lucide-react": "^0.468.0",
    "openapi-fetch": "^0.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "openapi-typescript": "^7.10.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^6.4.0"
  }
}
