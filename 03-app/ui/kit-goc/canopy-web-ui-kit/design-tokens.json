    },
    "2": {
      "$type": "shadow",
      "$value": [
        {
          "color": "#1B2B2A0A",
          "offsetX": "0px",
          "offsetY": "2px",
          "blur": "4px",
          "spread": "0px"
        },
        {
          "color": "#1B2B2A0F",
          "offsetX": "0px",
          "offsetY": "8px",
          "blur": "20px",
          "spread": "-6px"
        }
